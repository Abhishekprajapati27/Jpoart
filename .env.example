# Security
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (Leave unset for SQLite, or provide PostgreSQL DATABASE_URL)
# DATABASE_URL=postgres://user:password@localhost:5432/jport_db

# Email Configuration (Optional - console backend used by default in dev)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@jobportal.com

# Production Security Settings (when DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000


